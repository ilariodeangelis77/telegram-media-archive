ne-page-printing-bug/
*/
#content {
  overflow: visible !important;
}
.columns-1-1,
.columns-1-2,
.columns-3-1,
.columns-2-1,
.columns-1-1-1,
.columns-2-1-1 {
	overflow: visible !important;
}
.column1,
.column2,
.column3 {
  overflow: visible !important;
}
