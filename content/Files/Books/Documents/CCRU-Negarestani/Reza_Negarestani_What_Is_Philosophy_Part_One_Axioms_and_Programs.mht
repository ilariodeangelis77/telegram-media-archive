	float: left;
	display: block;
	width: 350px;
}

#footerRight .socialMedia {
	width: 350px;
	margin-top: 78px;
	display: block;
}

#footerRight .socialMedia a.addthis_button_tweet {
	position: relative;
	left: -2px;
	top: -5px;
}

#footerRight div.gCounter {
	margin-top: 5px;
}

/* END LEFT COL FOOTER */

/* START BOTTOM COL FOOTER */

#footerBottom {
	clear: both;
	display: block;
}

#footerBottom p {
	font-size: 13px;
	font-weight: normal;
    font-family: Helvetica, Arial, sans-serif;
    padding-top: 1px;
}

#footerBottom img {
	float: left;
	margin-right: 4px;
}

#footerBottom ul {
	float: left;
	margin-right: 57px;
	padding: 0;
	margin-top: 9px;
}

#footerBottom ul li {
	list-style: none;
	margin-bottom: 2px;
}

#footerBottom ul li a {
	color: #9c9c9c;
	font-size: 13px;
	font-weight: normal;
    font-family: Helvetica, Arial, sans-serif;
}

#footerBottom ul li a:hover {
	color: #000000;
	text-decoration: underline;
}

#footerBottom ul li a:focus {
	color: #000000;
	text-decoration: underline;
}

/* END BOTTOM COL FOOTER */


/* TIMEBANK */
.projectList .timeList {
	background-color: #faf200;
	border-top: 1px solid #000;
}

.projectList .firstList {
	border-top: 4px solid #000;
	margin-top: 15px;
}

.projectList .lastList {
	border-bottom: 4px solid #000;
	margin-bottom: 25px;
}

.projectList .timeList p {
	font-weight: bold;
	text-transform: uppercase;
	margin-left: 10px;
	margin-top: 8px;
}

#indexBottom .timeList a {
	font-weight: bold;
	text-transform: uppercase;
	color: #000;
}

#indexBottom .timeList a:hover {
	color: #F60;
	text-decoration: none;
}

.projectList .timeList span {
	margin-left: 10px;
	padding-top: 5px;
	margin-bottom: 8px;
	display: inline-block;
}

.projectList .first {
	margin-bottom: 4px;
}

/* footnote */
.journal-essay #content .footnote,
.journal-essay #content #columns sup a {
	font-weight: bold;
	font-family: helvetica, sans-serif;
	text-decoration: none;
	font-size: 11px;
	border: 0;
}

/* additional right column */
#content .rightCol .related li.title {
	margin-bottom: 5px;
	margin-top: 30px;
}

#content .rightCol .related li.author {
	margin-bottom: 0;
}

#content .rightCol .related li.excerpt {
	margin-top: 20px;
	margin-bottom: 0;
}


#content .rightCol .related li.source {
	margin-top: 10px;
}

#content .rightCol .related li.title1 {
	margin-top: 0;
	margin-bottom: 5px;
}

#content .videoTitle{
	margin-bottom: 5px;
	margin-top: 15px;
}

/* additional bottom */
#content .additionalBottom h3 {
	margin-top: 45px;
}

#content .additionalBottom .list .title {
	font-size: 1.384em;
	margin-bottom: 5px;
	margin-top: 45px;
}

#content .additionalBottom li#press1,
#content .additionalBottom li#video1,
#content .additionalBottom li#image1,
#content .additionalBottom li#blogReview1,
#content .additionalBottom li#audio1,
#content .additionalBottom li#title1,
#content .additionalBottom li#review1 {
	margin-top: 0;
}

#content .player-container {
	padding: 0;
}
#content .additionalBottom .content {
	margin-bottom: 0;
	margin-top: 20px;
}


/* SLIDER */


.article #content .moreFrom .smallHeader {
	border-bottom: 1px solid #D9D9D9;
	padding-bottom: 5px;
	font-size: 1.076em;
	margin-bottom: 30px;
}

